# Modelo do arquivo de ambiente do serviço (OS-037). NÃO coloque segredos neste modelo.
#
# No servidor: copie para /etc/academic-search-hub/env, dono root e modo 0600 (ou 0640 com o grupo do
# serviço) e preencha lá:
#   install -d -m 0750 /etc/academic-search-hub
#   install -m 0600 deploy/academic-search.env.example /etc/academic-search-hub/env
#
# Formato: uma linha NOME=valor, sem aspas e sem espaços em volta do "=".

APP_ENV=production

# Gere NO SERVIDOR e não repita em outro ambiente:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazia, a aplicação se recusa a iniciar em produção (de propósito).
SECRET_KEY=

# Se a senha tiver caracteres especiais (@ : / # %), escreva-os codificados (por exemplo @ vira %40).
DATABASE_URL=postgresql+psycopg://app_user:TROCAR-A-SENHA@127.0.0.1:5432/academic_search

# Endereço público do site, sem barra no fim e SEM "*" (em produção a aplicação recusa "*").
ALLOWED_ORIGINS=https://exemplo.org

# true mantém a documentação da API pública em /api/docs; false a desliga.
DOCS_ENABLED=true

OPENALEX_API_KEY=
CORE_API_KEY=
# Vai no User-Agent da colheita e da raspagem, para os administradores das fontes saberem de quem é.
CONTACT_EMAIL=

LOG_LEVEL=INFO
