# Ambiente: development ou production
APP_ENV=development
# Assinatura do JWT; obrigatório, mínimo de 32 bytes aleatórios (não commitar o valor real)
SECRET_KEY=
# Conexão com o PostgreSQL
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/academic_search
# Validade do token de acesso, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Origens permitidas no CORS, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:8000
# Chave gratuita do OpenAlex (conta em openalex.org)
OPENALEX_API_KEY=
# Chave gratuita do CORE (registro em core.ac.uk/services/api)
CORE_API_KEY=
# BDTD pela API REST pública do VuFind (sem chave); false desliga a fonte
BDTD_ENABLED=true
# Arquivo com as fontes OAI-PMH
OAI_SOURCES_FILE=config/oai_sources.yml
# E-mail de contato usado no User-Agent da colheita e da raspagem
CONTACT_EMAIL=
# Pausa, em segundos, entre requisições de colheita ao mesmo servidor
OAI_HARVEST_DELAY_SECONDS=1
# Liga a raspagem complementar de resumos (true/false). O padrão do código é false; este modelo liga.
SCRAPING_ENABLED=true
# Tempo limite, em segundos, por fonte de busca
SOURCE_TIMEOUT_SECONDS=10
# Tamanho de página padrão
DEFAULT_PAGE_SIZE=20
# Tamanho máximo de página
MAX_PAGE_SIZE=50
# Limite de requisições de busca, por IP
RATE_LIMIT_SEARCH=60/minute
# Limite de requisições de login e cadastro, por IP
RATE_LIMIT_AUTH=5/minute
# Nível de log
LOG_LEVEL=INFO
# Liga a documentação em /api/docs
DOCS_ENABLED=true
# Banco usado só nos testes de integração
TEST_DATABASE_URL=
# Versão da política de privacidade registrada no consentimento
PRIVACY_POLICY_VERSION=1.0
